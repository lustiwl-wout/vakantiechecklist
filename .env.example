# Postgres connection-string van Neon (kopieer uit het Neon dashboard, "Pooled connection" werkt prima)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Geheim voor JWT-tokens. Genereer iets willekeurigs van minstens 32 tekens.
JWT_SECRET=verander-mij-naar-iets-willekeurigs

# Poort (Render zet dit automatisch via PORT)
PORT=3000

# Optioneel: zet op 'production' om secure cookies af te dwingen
NODE_ENV=development
